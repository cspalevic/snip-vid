{
    "$schema": "./node_modules/wrangler/config-schema.json",
    "name": "snip-vid",
    "main": ".open-next/worker.js",
    // Set this to today's date
    "compatibility_date": "2026-08-26",
    "compatibility_flags": [
      "nodejs_compat"
    ],
    "assets": {
      "directory": ".open-next/assets",
      "binding": "ASSETS"
    },
    "observability": {
      "enabled": true
    },
    "routes": [
      {
        "pattern": "snip-vid.com",
        "custom_domain": true,
      },
    ]
  }